# Copy this file to `.env` and fill in the two values to turn on cloud sync.
# Until you do, the app runs perfectly well entirely on your device.
#
# Both values come from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# The anon key is safe to ship in a browser app AS LONG AS Row Level Security
# is enabled on your tables (supabase/schema.sql does this). It only grants
# what your RLS policies allow, which is "rows belonging to the signed-in user".
#
# Vite only exposes variables that start with VITE_ to your app code.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
